class Solution {
public:
    string longestPalindrome(string s) {
        if (s.empty()) return "";
        
        int start = 0;
        int maxLen = 0;
        
        auto expandAroundCenter = [&](int left, int right) {
            while (left >= 0 && right < s.length() && s[left] == s[right]) {
                left--;
                right++;
            }
            // Length of the palindrome found
            int len = right - left - 1;
            if (len > maxLen) {
                maxLen = len;
                start = left + 1; // Correct starting index
            }
        };
        
        for (int i = 0; i < s.length(); ++i) {
            expandAroundCenter(i, i);     // Odd-length palindromes (single character center)
            expandAroundCenter(i, i + 1); // Even-length palindromes (two-character center)
        }
        
        return s.substr(start, maxLen);
    }
};
