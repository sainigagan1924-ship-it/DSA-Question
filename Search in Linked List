/*
Given a linked list with the head node and a key, the task is to check if the key is present in the linked list or not. 

Example:

Input: key = 3,
      
Output: true 
Explanation: 3 is present in Linked List.
Input: key = 4,
   
Output: false
Explanation: 4 is not present in Linked List.
Constraints:

1 ≤ no. of nodes in head ≤ 105
1 ≤ key ≤ 105
*/

// code

/* Structure of Linked List Node
class Node {
  public:
    int data;
    Node* next;

    Node(int x) {
        data = x;
        next = nullptr;
    }
}; */

class Solution {
  public:
    bool searchKey(Node* head, int key) {
        // Code here
        Node *t = head;
        if(t->data == key) return true;
        while(t->next != nullptr){
            t = t-> next;
            if(t->data == key){
                return true;
            }
        }
        return false;
    }
};
